# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Postgres connection string. Matches docker-compose.yml by default —
# run `docker compose up -d` to start a local database with these credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google AI Studio (Gemini) API key — get one free at
# https://aistudio.google.com/apikey. Powers the AI story generator and the
# "Ask NeuroEcho AI" assistant (gemini-3.6-flash). Both features fall back
# to static content if this is unset, so it's optional for local dev.
GEMINI_API_KEY=
